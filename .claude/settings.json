{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -c:*)",
      "Bash(.venv/Scripts/python.exe -m:*)",
      "Bash(../.venv/Scripts/python.exe -c:*)",
      "Bash(../.venv/Scripts/python.exe -m:*)",
      "Bash(python -c:*)",
      "Bash(python -m py_compile:*)",
      "Bash(python -m pytest:*)",
      "PowerShell(Start-Job:*)",
      "PowerShell(Stop-Job:*)",
      "PowerShell(Remove-Job:*)",
      "PowerShell(Invoke-WebRequest -Uri \"http://localhost:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ]
  }
}
